# GitHub Personal Access Token (required)
# Scopes needed: "public_repo" (read-only access to public repository metadata)
# NEVER commit the real .env file to version control.
GITHUB_TOKEN=your_github_personal_access_token_here

# GitHub REST API base URL (override only for GitHub Enterprise)
GITHUB_API_BASE_URL=https://api.github.com

# HTTP client timeout (seconds) for outbound GitHub API calls
GITHUB_API_TIMEOUT_SECONDS=10

# Application log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Local directory where cloned repositories are stored (Module 2).
# Repositories are cloned into WORKSPACE_DIRECTORY/{owner}_{repo}.
WORKSPACE_DIRECTORY=./workspace
